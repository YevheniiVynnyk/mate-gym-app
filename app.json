{
  "expo": {
	"name": "Mate Gym App",
	"slug": "mate-gym-app",
	"version": "1.0.0",
	"extra": {
	  "admobBannerIdAndroid": "ca-app-pub-XXXXXXXXXX/YYYYYYYYYY",
	  "admobBannerIdIos": "ca-app-pub-XXXXXXXXXX/ZZZZZZZZZZ"
	},
	"orientation": "default",
	"icon": "./assets/images/icon.png",
	"scheme": "mategymapp",
	"userInterfaceStyle": "automatic",
	"newArchEnabled": true,
	"ios": {
	  "supportsTablet": true,
	  "bundleIdentifier": "com.vynnyk.mategymapp",
	  "associatedDomains": [
		"applinks:mate-gym-api.onrender.com"
	  ]
	},
	"android": {
	  "adaptiveIcon": {
		"backgroundColor": "#E6F4FE",
		"backgroundImage": "./assets/images/432.png"
	  },
	  "package": "com.vynnyk.mategymapp",
	  "intentFilters": [
		{
		  "action": "VIEW",
		  "autoVerify": true,
		  "data": [
			{
			  "scheme": "https",
			  "host": "mate-gym-api.onrender.com",
			  "pathPrefix": "/reset-password"
			}
		  ],
		  "category": [
			"BROWSABLE",
			"DEFAULT"
		  ]
		}
	  ]
	},
	"plugins": [
	  "expo-router",
	  [
		"expo-splash-screen",
		{
		  "image": "./assets/images/512.png",
		  "imageWidth": 200,
		  "resizeMode": "contain",
		  "backgroundColor": "#ffffff",
		  "dark": {
			"backgroundColor": "#000000"
		  }
		}
	  ],
	  "expo-localization",
	  [
		"react-native-google-mobile-ads",
		{
		  "androidAppId": "ca-app-pub-3240569896257496~1234567890",
		  "iosAppId": "ca-app-pub-3240569896257496~0987654321"
		}
	  ]
	],
	"experiments": {
	  "typedRoutes": true,
	  "reactCompiler": true
	},
	"owner": "mate-gym-app",
	"extra": {
	  "router": {},
	  "eas": {
		"projectId": "7d1c6bb3-e572-4919-9da1-7eabfa194fbd"
	  }
	}
  }
}